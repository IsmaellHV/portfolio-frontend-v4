---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/nunito';
import '~/styles/global.css';
import type { Locale } from '~/data/portfolio';
import { UI_BY_LOCALE } from '~/data/ui';
import { UMAMI_WEBSITE_ID, absoluteUrl, homePath } from '~/lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  keywords?: string;
  jsonLd?: object[];
  /** Path of this page in each locale; defaults to the home pages. */
  paths?: Record<Locale, string>;
  ogType?: 'profile' | 'article';
}

const {
  locale,
  title,
  description,
  keywords,
  jsonLd = [],
  paths = { en: homePath('en'), es: homePath('es') },
  ogType = 'profile',
} = Astro.props;

const ui = UI_BY_LOCALE[locale];
const canonical = absoluteUrl(paths[locale]);
const altEn = absoluteUrl(paths.en);
const altEs = absoluteUrl(paths.es);
const ogImage = absoluteUrl('/og.png');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Ismael Hurtado Vargas" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ismael Hurtado · Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_PE'} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0c0b" media="(prefers-color-scheme: dark)" />

    {jsonLd.map(block => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}

    {
      import.meta.env.PROD && (
        <script is:inline defer src="/visitas.js" data-website-id={UMAMI_WEBSITE_ID} data-domains="ismaelhv.com" />
      )
    }

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('pf4_theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{ui.skipLink}</a>
    <slot />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const isDark = () =>
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const syncPressed = () => btn?.setAttribute('aria-pressed', String(isDark()));
        syncPressed();
        btn?.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('pf4_theme', next);
          } catch {}
          syncPressed();
        });
      })();
    </script>
  </body>
</html>
