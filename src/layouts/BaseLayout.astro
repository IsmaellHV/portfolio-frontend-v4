---
import '~/styles/global.css';
import type { Locale } from '~/data/portfolio';
import { absoluteUrl, homePath } from '~/lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  keywords?: string;
  jsonLd?: object[];
}

const { locale, title, description, keywords, jsonLd = [] } = Astro.props;

const canonical = absoluteUrl(homePath(locale));
const altEn = absoluteUrl(homePath('en'));
const altEs = absoluteUrl(homePath('es'));
const ogImage = absoluteUrl('/og.png');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Ismael Hurtado Vargas" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ismael Hurtado — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_PE'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />

    {jsonLd.map(block => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!-- Theme init: runs before paint to avoid flash -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('pf4_theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('pf4_theme', next);
      });
    </script>
  </body>
</html>
