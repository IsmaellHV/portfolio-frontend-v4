---
import type { Locale } from '~/data/portfolio';
import { getPortfolioData } from '~/data/portfolio';
import { UI_BY_LOCALE } from '~/data/ui';
import { CV_BY_LOCALE, CONTACT_EMAIL, homePath } from '~/lib/site';
import { CHATT_WORLD_PATHS } from '~/data/case-studies';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import ChatPreview from '~/components/ChatPreview.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getPortfolioData(locale);
const ui = UI_BY_LOCALE[locale];
const cv = CV_BY_LOCALE[locale];
const paths = { en: homePath('en'), es: homePath('es') };
const linkedin = data.profile.socials.find(s => s.platform === 'LinkedIn');
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<SiteHeader {locale} {paths} />

<main id="main" tabindex="-1">
  <span id="top"></span>

  <section aria-labelledby="hero-title" class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{data.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-title">{data.hero.title}</h1>
      <p class="hero-lead">{data.hero.lead}</p>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={cv}
          download
          data-umami-event="descargar-cv"
          data-umami-event-idioma={locale}
          data-umami-event-lugar="portada"
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          {ui.downloadCV}
        </a>
        <a class="btn btn-ghost" href="#experience">
          {ui.viewExperience}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
        </a>
      </div>
      <div class="hero-links">
        {
          data.profile.socials.map(s => (
            <a
              class="text-link tap"
              href={s.url}
              {...external}
              data-umami-event="contacto"
              data-umami-event-canal={s.platform}
              data-umami-event-lugar="portada"
            >
              {s.platform} ↗
            </a>
          ))
        }
        <a
          class="text-link tap"
          href={`mailto:${CONTACT_EMAIL}`}
          data-umami-event="contacto"
          data-umami-event-canal="email"
          data-umami-event-lugar="portada">{CONTACT_EMAIL}</a
        >
      </div>
    </div>
    <figure aria-label={ui.chatFigure} class="hero-figure">
      <ChatPreview chat={data.chat} />
      <figcaption class="hero-caption">
        <span>{ui.chatCaption}</span>
        <a
          class="text-link"
          href={CHATT_WORLD_PATHS[locale]}
          data-umami-event="caso-estudio"
          data-umami-event-lugar="portada">{ui.readCaseStudy} →</a
        >
      </figcaption>
    </figure>
  </section>

  <section id="experience" aria-labelledby="exp-title" class="band">
    <div class="wrap section">
      <div class="section-head">
        <p class="kicker">{ui.experience.kicker}</p>
        <h2 id="exp-title" class="h2">{ui.experience.title}</h2>
      </div>
      <ol class="exp-list">
        {
          data.experiences.map(exp => (
            <li class="exp">
              <div class="exp-when">
                <p class="exp-period">{exp.period}</p>
                <p class="exp-place">{exp.place}</p>
              </div>
              <div class="exp-body">
                <h3 class="exp-title">
                  {exp.role} <span class="exp-company">· {exp.company}</span>
                </h3>
                <ul class="bullets muted">
                  {exp.bullets.map(b => (
                    <li>{b}</li>
                  ))}
                </ul>
                <p class="stack">{exp.stack.join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a
        class="text-link tap muted"
        href={cv}
        download
        data-umami-event="descargar-cv"
        data-umami-event-idioma={locale}
        data-umami-event-lugar="experiencia">{ui.experience.fullHistory} →</a
      >
    </div>
  </section>

  <section id="work" aria-labelledby="work-title" class="wrap section">
    <div class="section-head section-head-split">
      <div class="section-head">
        <p class="kicker">{ui.work.kicker}</p>
        <h2 id="work-title" class="h2">{ui.work.title}</h2>
      </div>
      <p class="muted section-lead">{ui.work.lead}</p>
    </div>

    {
      data.featuredProducts.map(p => (
        <article class="card feature">
          <div class="feature-main">
            <div class="pills">
              <span class:list={['pill', p.accent ? 'pill-accent' : 'pill-neutral']}>{p.badge}</span>
              <span class="pill pill-outline">{p.meta}</span>
            </div>
            <h3 class="feature-title">
              {p.logo && <img src={p.logo} alt="" width="36" height="36" />}
              {p.title}
            </h3>
            <p class="feature-summary muted">{p.summary}</p>
            <ul class="bullets">
              {p.highlights.map(h => (
                <li>{h}</li>
              ))}
            </ul>
            {(p.caseStudy || p.link) && (
              <div class="feature-links">
                {p.caseStudy && (
                  <a class="btn btn-ghost btn-sm" href={p.caseStudy} data-umami-event="caso-estudio" data-umami-event-lugar="productos">
                    {ui.readCaseStudy} →
                  </a>
                )}
                {p.link && (
                  <a
                    class="text-link tap muted"
                    href={p.link}
                    {...external}
                    data-umami-event="visitar-producto"
                    data-umami-event-producto={p.title}
                  >
                    {ui.visitSite} ↗
                  </a>
                )}
              </div>
            )}
          </div>
          <dl class="feature-aside">
            <div>
              <dt class="label">{ui.work.role}</dt>
              <dd>{p.role}</dd>
            </div>
            <div>
              <dt class="label">{ui.work.stack}</dt>
              <dd class="muted">{p.stack.join(' · ')}</dd>
            </div>
          </dl>
        </article>
      ))
    }

    <div class="product-grid">
      {
        data.products.map(p => (
          <article class="card product">
            <img
              class="product-shot"
              src={p.image.src}
              alt={p.image.alt}
              width="960"
              height="600"
              loading="lazy"
              decoding="async"
            />
            <div class="product-body">
              <div class="product-meta">
                <span>{p.kind}</span>
                {p.link ? (
                  <a
                  class="text-link"
                  href={p.link}
                  {...external}
                  data-umami-event="visitar-producto"
                  data-umami-event-producto={p.title}
                >
                    {p.linkLabel} ↗
                  </a>
                ) : (
                  p.note && <span>{p.note}</span>
                )}
              </div>
              <h3 class="product-title">{p.title}</h3>
              <p class="muted">{p.description}</p>
              <p class="stack product-stack">{p.stack.join(' · ')}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title" class="wrap section">
    <div class="section-head">
      <p class="kicker">{ui.skills.kicker}</p>
      <h2 id="skills-title" class="h2">{ui.skills.title}</h2>
    </div>
    <div class="rule-grid rule-grid-4">
      {
        data.skills.map(g => (
          <div class="rule-item">
            <h3 class="rule-title">{g.title}</h3>
            <p class="muted">{g.items}</p>
          </div>
        ))
      }
    </div>
    <div class="info-cards">
      <div class="info-card">
        <h3 class="label">{ui.skills.education}</h3>
        {
          data.education.map(e => (
            <p>
              <strong>{e.degree}</strong>
              <br />
              <span class="muted">{e.detail}</span>
            </p>
          ))
        }
      </div>
      <div class="info-card">
        <h3 class="label">{ui.skills.certifications}</h3>
        <ul class="cert-list">
          {
            data.certifications.map(c => (
              <li>
                <span>{c.name}</span>
                <span class="faint">
                  {c.issuer} · {c.year}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title" class="band band-top">
    <div class="wrap section">
      <div class="section-head">
        <p class="kicker">{ui.contact.kicker}</p>
        <h2 id="contact-title" class="h2">{ui.contact.title}</h2>
        <p class="section-lead-lg muted">{ui.contact.lead}</p>
      </div>
      <dl class="rule-grid rule-grid-3">
        <div class="rule-item">
          <dt class="label">{ui.contact.roles}</dt>
          <dd class="contact-value">
            {
              data.contact.roles.map((r, i) => (
                <>
                  {i > 0 && <br />}
                  {r}
                </>
              ))
            }
          </dd>
        </div>
        <div class="rule-item">
          <dt class="label">{ui.contact.workMode}</dt>
          <dd class="contact-value">{data.contact.workMode}</dd>
        </div>
        <div class="rule-item">
          <dt class="label">{ui.contact.timeZone}</dt>
          <dd class="contact-value">
            {data.contact.timeZone}
            <br />
            <span class="muted">{data.contact.timeZoneNote}</span>
          </dd>
        </div>
      </dl>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={`mailto:${CONTACT_EMAIL}`}
          data-umami-event="contacto"
          data-umami-event-canal="email"
          data-umami-event-lugar="contacto">{CONTACT_EMAIL}</a
        >
        {
          linkedin && (
            <a
              class="btn btn-ghost"
              href={linkedin.url}
              {...external}
              data-umami-event="contacto"
              data-umami-event-canal="LinkedIn"
              data-umami-event-lugar="contacto"
            >
              LinkedIn
            </a>
          )
        }
        <a
          class="btn btn-ghost"
          href={CV_BY_LOCALE.en}
          download
          hreflang="en"
          data-umami-event="descargar-cv"
          data-umami-event-idioma="en"
          data-umami-event-lugar="contacto">{ui.contact.cvEn}</a
        >
        <a
          class="btn btn-ghost"
          href={CV_BY_LOCALE.es}
          download
          hreflang="es"
          data-umami-event="descargar-cv"
          data-umami-event-idioma="es"
          data-umami-event-lugar="contacto">{ui.contact.cvEs}</a
        >
      </div>
    </div>
  </section>
</main>

<SiteFooter {locale} />
