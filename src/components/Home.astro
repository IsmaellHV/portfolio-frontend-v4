---
import type { Locale } from '~/data/portfolio';
import { getPortfolioData } from '~/data/portfolio';
import { UI_BY_LOCALE } from '~/data/ui';
import { CV_BY_LOCALE, CONTACT_EMAIL, PREVIOUS_VERSIONS, homePath } from '~/lib/site';
import ExperienceEntry from '~/components/ExperienceEntry.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getPortfolioData(locale);
const ui = UI_BY_LOCALE[locale];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const year = new Date().getFullYear();

// Show the 4 most recent roles; collapse the rest (ATU, Cobra) behind a toggle
// so six dense entries don't read as one wall. Data is already newest-first.
const RECENT_COUNT = 4;
const recentExperiences = data.experiences.slice(0, RECENT_COUNT);
const olderExperiences = data.experiences.slice(RECENT_COUNT);

const navItems = [
  { id: 'about', label: ui.aboutKicker },
  { id: 'experience', label: ui.nav.experience },
  { id: 'projects', label: ui.nav.projects },
];
---

<div class="mx-auto min-h-screen max-w-6xl px-6 lg:flex lg:justify-between lg:gap-10">
  <!-- LEFT · sticky identity column -->
  <header class="pt-12 pb-8 lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-[42%] lg:max-w-md lg:flex-col lg:justify-between lg:py-16">
    <div>
      <a href={homePath(locale)} class="inline-flex items-center gap-2.5" aria-label="ismaelhv.com">
        <img src="/favicon.svg" alt="" width="34" height="34" class="h-[34px] w-[34px]" />
        <span class="faint font-mono text-xs tracking-tight">ismaelhv<span style="color: var(--accent-ink)">.com</span></span>
      </a>
      <h1 class="font-display mt-3 text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.05]">{data.profile.name}</h1>
      <p class="font-display mt-1.5 text-lg font-medium" style="color: var(--accent-ink)">{data.profile.role}</p>
      <p class="muted mt-4 max-w-xs text-sm leading-relaxed">{data.profile.tagline}</p>

      <!-- actions -->
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a href={CV_BY_LOCALE[locale]} download class="btn btn-primary">↓ {ui.hero.downloadCV}</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn">{ui.hero.contact}</a>
        <div class="relative" id="versions">
          <button
            type="button"
            id="versions-btn"
            class="btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="versions-menu"
          >
            {ui.previousVersions}
            <span aria-hidden="true" class="faint">▾</span>
          </button>
          <div id="versions-menu" class="versions-menu" role="menu" hidden>
            {
              PREVIOUS_VERSIONS.map(v => (
                <a href={v.url} target="_blank" rel="noopener noreferrer" class="versions-item" role="menuitem">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold">
                      {v.label} <span class="faint font-mono text-xs">· {v.year}</span>
                    </span>
                    <span class="link-accent text-xs">↗</span>
                  </span>
                  <span class="faint mt-0.5 block font-mono text-xs">{v.stack}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- in-page nav (desktop only) -->
      <nav class="mt-14 hidden lg:block" aria-label="In-page">
        <ul class="space-y-3">
          {
            navItems.map(item => (
              <li>
                <a href={`#${item.id}`} class="side-nav-link" data-nav={item.id}>
                  <span class="side-nav-line" aria-hidden="true" />
                  <span class="side-nav-text">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- bottom cluster -->
    <div class="mt-10 lg:mt-0">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          data.profile.socials.map(s => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="muted inline-flex min-h-[44px] items-center hover:text-[var(--accent-ink)]"
            >
              {s.platform}
            </a>
          ))
        }
      </div>
      <div class="mt-4 flex items-center gap-2">
        <a href={homePath(otherLocale)} class="icon-btn" title={ui.langSwitch} aria-label={ui.langSwitch}>
          {otherLocale.toUpperCase()}
        </a>
        <button
          id="theme-toggle"
          type="button"
          class="icon-btn cursor-pointer"
          title={ui.themeToggle}
          aria-label={ui.themeToggle}
          aria-pressed="false"
        >
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </div>
  </header>

  <!-- RIGHT · scrolling content -->
  <main id="main" tabindex="-1" class="pb-16 focus:outline-none lg:w-[54%] lg:py-16">
    <!-- ABOUT -->
    <section id="about" class="scroll-mt-8">
      <h2 class="sr-only">{ui.aboutKicker}</h2>
      <p class="kicker mb-4 lg:hidden">{ui.aboutKicker}</p>
      <div class="muted space-y-4 text-sm leading-relaxed sm:text-[0.95rem]">
        {data.about.paragraphs.map(p => <p>{p}</p>)}
      </div>
      <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-3">
        {
          data.about.meta.map(([label, value]) => (
            <div>
              <dt class="faint text-xs tracking-wide uppercase">{label}</dt>
              <dd class="mt-0.5 font-medium">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="scroll-mt-8 pt-16">
      <div class="section-divider mb-2 flex items-baseline justify-between pt-6">
        <h2 class="kicker">{ui.experienceKicker}</h2>
        <p class="faint font-mono text-xs">{String(data.experiences.length).padStart(2, '0')}</p>
      </div>
      {recentExperiences.map(exp => <ExperienceEntry exp={exp} currentLabel={ui.current} />)}
      {
        olderExperiences.length > 0 && (
          <details class="exp-more mt-2">
            <summary>
              {ui.experienceMore} ({olderExperiences.length})
            </summary>
            {olderExperiences.map(exp => <ExperienceEntry exp={exp} currentLabel={ui.current} />)}
          </details>
        )
      }
      <a href={CV_BY_LOCALE[locale]} download class="link-accent mt-6 inline-flex items-center gap-1 text-sm font-semibold">
        ↓ {ui.hero.downloadCV}
      </a>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="scroll-mt-8 pt-16">
      <div class="section-divider mb-4 pt-6">
        <p class="kicker">{ui.projectsKicker}</p>
        <h2 class="font-display mt-1 text-xl font-bold tracking-tight">{data.sections.projectsHeadline}</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          data.featuredProjects.map(project => (
            <article class="project-card flex flex-col">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display font-semibold">{project.title}</h3>
                {project.year && <span class="faint font-mono text-xs">{project.year}</span>}
              </div>
              <p class="muted mt-2 flex-1 text-sm leading-relaxed">{project.description}</p>
              {project.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {project.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <div class="mt-4 flex gap-4 text-sm">
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="link-accent">
                    {ui.visit} ↗
                  </a>
                )}
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="link-accent">
                    {ui.code} ↗
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <p class="faint mt-12 text-xs leading-relaxed">
        © {year} {data.profile.name}. {ui.footer.rights} · Astro · Tailwind CSS.
      </p>
    </section>
  </main>
</div>

<script>
  // Previous-versions dropdown
  const wrap = document.getElementById('versions');
  const btn = document.getElementById('versions-btn');
  const menu = document.getElementById('versions-menu');
  if (wrap && btn && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', e => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener('click', e => {
      if (!wrap.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Active-section highlight in the side nav
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLElement>('[data-nav]')).map(l => [l.dataset.nav, l]),
  );
  if (links.size) {
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach(l => l.classList.remove('active'));
            links.get(entry.target.id)?.classList.add('active');
          }
        }
      },
      { rootMargin: '-35% 0px -60% 0px', threshold: 0 },
    );
    ['about', 'experience', 'projects'].forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
