---
import type { ChatPreview } from '~/data/portfolio';

interface Props {
  chat: ChatPreview;
}

const { chat } = Astro.props;
---

<!-- Mirrors the Chatt World sign-in demo (chat-frontend/src/componentes/Presentacion.tsx): same bubbles, colors and type. -->
<div class="cw" aria-hidden="true">
  <div class="cw-bar">
    <span class="cw-brand">
      <img src="/work/chatt-world-logo.svg" alt="" width="24" height="24" />
      Chatt World
    </span>
    <span class="cw-lang">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.4"></circle><path d="M2.6 10h14.8M10 2.6c2 2.1 3 4.6 3 7.4s-1 5.3-3 7.4c-2-2.1-3-4.6-3-7.4s1-5.3 3-7.4z"></path></svg>
      {chat.readerLang}
    </span>
  </div>
  <div class="cw-canvas">
    {
      chat.messages.map(m => (
        <div class="cw-bubble">
          <p class="cw-name">{m.name}</p>
          <p class="cw-text" lang={m.lang}>
            {m.original}
          </p>
          <div class="cw-translation">
            <span class="cw-tag">
              <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h7M6.5 4v2M8.4 6c0 3-2 5.4-5.4 6.6M5 9.2c.9 2 2.6 3.4 5 4.2M11 17l3.4-8 3.4 8M12.5 14.4h4.8"></path></svg>
              {m.lang.toUpperCase()} → {chat.readerLang}
            </span>
            <p class="cw-translated">{m.translation}</p>
          </div>
          <p class="cw-time">{m.time}</p>
        </div>
      ))
    }
    <div class="cw-bubble cw-mine">
      <p class="cw-text">{chat.reply.text}</p>
      <p class="cw-time">
        {chat.reply.time}
        <svg class="cw-read" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 10.5 6 14l6-8"></path><path d="M9 12.6 10.4 14l6-8"></path></svg>
      </p>
    </div>
  </div>
</div>
